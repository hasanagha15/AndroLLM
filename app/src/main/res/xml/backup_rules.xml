<?xml version="1.0" encoding="utf-8"?>
<full-backup-content xmlns:android="http://schemas.android.com/apk/res/android">
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    <include domain="file" path="." />
    <!-- F1: user-typed personal context and protected payment apps stay on this device -->
    <exclude domain="file" path="datastore/personal_context_prefs.preferences_pb" />
    <exclude domain="sharedpref" path="sensitive_app_guard.xml" />
    <!-- K: protected payment apps moved to DataStore (legacy sharedpref above kept excluded) -->
    <exclude domain="file" path="datastore/sensitive_app_guard_prefs.preferences_pb" />
    <!-- Branch L: App Atlas settings (exclusion list names installed apps); the atlas DB itself lives in no_backup -->
    <exclude domain="sharedpref" path="app_atlas_settings.xml" />
</full-backup-content>