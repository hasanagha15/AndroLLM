<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup / device-transfer rules (android:dataExtractionRules).
    Branch L gate M2: proper <data-extraction-rules> format (the old <ruleset>
    root is not a valid dataExtractionRules document). F1 and K exclusions kept
    in both sections.

    Only the "file" domain is included. SharedPreferences are therefore NOT
    backed up or transferred at all on Android 12+ - this keeps
    sensitive_app_guard.xml (F1 legacy) and app_atlas_settings.xml (branch L,
    the exclusion list names installed apps) on the device, as well as
    app_update_watcher.xml and jarvis_event_outbox.xml (branch R1, installed
    package names). Do not add an <include domain="sharedpref"> here without
    excluding these files. The App
    Atlas database lives in no_backup/ (never part of any domain).
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <!-- F1: user-typed personal context stays on this device -->
        <exclude domain="file" path="datastore/personal_context_prefs.preferences_pb" />
        <!-- K: protected payment apps (DataStore) stay on this device -->
        <exclude domain="file" path="datastore/sensitive_app_guard_prefs.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <!-- F1: user-typed personal context stays on this device -->
        <exclude domain="file" path="datastore/personal_context_prefs.preferences_pb" />
        <!-- K: protected payment apps (DataStore) stay on this device -->
        <exclude domain="file" path="datastore/sensitive_app_guard_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
