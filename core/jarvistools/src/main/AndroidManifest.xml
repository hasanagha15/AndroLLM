<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network to tesla-bridge (HTTPS) and the WhatsApp bot (Tailscale). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Glasses mirror: a notification the Even app forwards to the G2. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Scoped cleartext rules for the Jarvis tools (see res/xml/jarvis_network_security_config.xml). -->
    <application android:networkSecurityConfig="@xml/jarvis_network_security_config" />
</manifest>
